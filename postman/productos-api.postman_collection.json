          "raw": "{\n  \"nombre\": \"Monitor LG 24MP400\",\n  \"descripcion\": \"Monitor Full HD de 24 pulgadas.\",\n  \"cantidad\": 6,\n  \"estado\": \"activo\",\n  \"fotoUrl\": \"https://example.com/images/monitor-lg-24mp400.jpg\"\n}"
